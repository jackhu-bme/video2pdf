# Copy this file to .env and fill in your own keys.
# Do not commit .env.

# Text model: DeepSeek V4
TEXT_PROVIDER=deepseek
TEXT_BASE_URL=https://api.deepseek.com
TEXT_API_KEY=your_deepseek_api_key
TEXT_MODEL=deepseek-v4-flash
# Use deepseek-v4-pro for final integration or harder reasoning-heavy passes.
TEXT_STRONG_MODEL=deepseek-v4-pro

# Vision model: Kimi
VISION_PROVIDER=kimi
VISION_BASE_URL=https://api.moonshot.ai/v1
VISION_API_KEY=your_moonshot_api_key
VISION_MODEL=kimi-k2.6
# Fallback if kimi-k2.6 is unavailable in your account:
# VISION_MODEL=moonshot-v1-128k-vision-preview

# Local Whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=

# Optional yt-dlp settings
YTDLP_COOKIES_FROM_BROWSER=chrome
